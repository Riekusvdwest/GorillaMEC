# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://gorillamec.com

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only (Stripe webhooks, billing). Keep it out of the browser and out of chat.
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe (optional until you take payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...
STRIPE_PRICE_GOLD_MONTHLY=price_...
STRIPE_PRICE_GOLD_ANNUAL=price_...
# Set to true once Stripe Tax is activated in your Stripe account
STRIPE_AUTOMATIC_TAX=false
